# Required provider keys. Each model uses only its matching server-side key.
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Initial website choice: grok-4.5 or deepseek-v4-pro.
AI_MODEL=grok-4.5

# Overall score at or above this value is labelled as passing.
REVIEW_PASS_SCORE=80

# Optional server-only settings.
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=600000
XAI_STREAM=true
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=600000
DEEPSEEK_STREAM=true

# Authentication runtime. Set APP_ENV=production on the deployed Worker.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Required in production. Use a randomly generated value of at least 32 characters.
# This secret protects rate-limit identifiers and must not use a NEXT_PUBLIC_ prefix.
AUTH_SECRET=replace-with-a-random-32-byte-or-longer-secret
# Stable password-proof pepper. Keep this separate from AUTH_SECRET in
# production; changing it requires users to set their passwords again.
PASSWORD_PEPPER=replace-with-a-different-random-32-byte-or-longer-secret

# Optional bounded lifetimes (defaults: 12-hour sessions and 24-hour setup links).
SESSION_TTL_SECONDS=43200
PASSWORD_SETUP_TTL_SECONDS=86400

# Employee notifications and Resend sender identity.
ACCOUNT_APPROVAL_NOTIFICATION_EMAIL=approvals@example.com
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=PressReady

# Local development uses preview mode and does not send or log email/token bodies.
# Production must use EMAIL_DELIVERY_MODE=http.
EMAIL_DELIVERY_MODE=preview

# Resend HTTP delivery. Keep the API key secret and configure these values only
# when EMAIL_DELIVERY_MODE=http. For a domain-free Resend test, use
# EMAIL_FROM_ADDRESS=onboarding@resend.dev and send only to the Resend account email.
EMAIL_PROVIDER_API_URL=https://api.resend.com/emails
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_AUTH_HEADER=Authorization
EMAIL_PROVIDER_AUTH_SCHEME=Bearer

# Used only by scripts/create-employee.mjs when the D1 database is renamed.
AUTH_D1_DATABASE_NAME=pressready-auth
