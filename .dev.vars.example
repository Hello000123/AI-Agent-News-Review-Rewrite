# Select Next.js development environment files when previewing in workerd.
NEXTJS_ENV=development

# Worker runtime settings. Use development-only values here and never commit
# the real .dev.vars file.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:8787
AUTH_SECRET=replace-with-a-local-random-32-byte-or-longer-secret
SESSION_TTL_SECONDS=43200
PASSWORD_SETUP_TTL_SECONDS=86400

# Development email preview mode records delivery metadata in D1 without
# sending externally or logging message bodies and setup tokens.
ACCOUNT_APPROVAL_NOTIFICATION_EMAIL=approvals@example.test
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=PressReady
EMAIL_DELIVERY_MODE=preview

# AI provider credentials are needed only when exercising review/rewrite.
XAI_API_KEY=
DEEPSEEK_API_KEY=
AI_MODEL=grok-4.5

# For HTTP email delivery, configure these as Worker secrets/variables in
# production and set EMAIL_DELIVERY_MODE=http.
EMAIL_PROVIDER_API_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_AUTH_HEADER=Authorization
EMAIL_PROVIDER_AUTH_SCHEME=Bearer
